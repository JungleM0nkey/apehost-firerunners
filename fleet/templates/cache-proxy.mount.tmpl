# {{.Header}}
# RAM-backed storage for fireactions-cache-proxy: artifacts and the index share
# one tmpfs, so a reboot always yields a consistent cold cache.
[Unit]
Description=tmpfs for the fireactions Turborepo cache proxy
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=tmpfs-fireactions-turbocache
Where={{.Dir}}
Type=tmpfs
Options=size={{.TmpfsSize}},mode=0700,nosuid,nodev,noexec

[Install]
WantedBy=local-fs.target
